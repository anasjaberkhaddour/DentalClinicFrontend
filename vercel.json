{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/DentalClinicApp/browser",
  "rewrites": [
    {
      "source": "/api/keep-alive",
      "destination": "/api/keep-alive"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/keep-alive",
      "schedule": "0 0 */3 * *"
    }
  ]
}